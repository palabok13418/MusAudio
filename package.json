{
  "name": "musaudio-website",
  "private": true,
  "version": "0.0.0",
  "description": "MusAudio — Website Version (static site + serverless proxy endpoints)",
  "license": "UNLICENSED",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "vite build",
    "vercel-build": "vite build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "dev": "http-server -c-1 -p 5173 .",
    "dev:vite": "vite --port 5174 --strictPort",
    "build:vite": "vite build",
    "preview:vite": "vite preview --port 5174 --strictPort"
  },
  "dependencies": {
    "@netlify/neon": "^0.1.0",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "fluent-ffmpeg": "^2.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^15.12.0",
    "http-server": "^14.1.1",
    "prettier": "^3.7.4",
    "vite": "5.4.19"
  }
}
